# === Bolsa de Trabajo — Variables de Entorno ===
# Copiar este archivo como .env y completar los valores reales.

# Base de Datos MySQL
DB_NAME=oficina_empleo_sanjose
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql

# Seguridad JWT (clave de firma de tokens — usar cadena larga y aleatoria)
JWT_SECRET=una_clave_secreta_muy_larga_y_aleatoria_de_al_menos_64_caracteres

# Contraseña del superadmin (si se deja vacía, se genera una aleatoria en el primer arranque)
SUPERADMIN_PASSWORD=

# CORS — orígenes permitidos para el frontend (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173

# Swagger/OpenAPI — true para habilitar en desarrollo
SWAGGER_ENABLED=false
